MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1277049867}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 049ce0b218bc5304dbaad75dd6ec1736, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Restarted: {fileID: 11400000, guid: fb7c25c1b1c0f6843a386375e1c41dbc, type: 2}
  _inicio: 1
  _fail: 0
  _finalizado: 0
  BoteDestruido: 0
  _interactionObj: {fileID: 1277049867}
  _interactionText: {fileID: 39227983}
  _triangulo: {fileID: 1027196622}
  _oldScientistObj: {fileID: 557870909}
  _mainCharacterObj: {fileID: 702597916}
  NpcInteraction:
  - NPC: 1
    FacialExpression: {fileID: 21300000, guid: fcc7b7da56f7dcf47974ddc97e8f6f33, type: 3}
    IMG: {fileID: 621860212}
    NpcDialogue: "Obrigado por aceitar nos ajudar. Precis\xE1vamos de uma pesquisadora
      de aves, uma ornitologista, como voc\xEA."
  - NPC: 0
    FacialExpression: {fileID: 21300000, guid: 658f07af1690c7a44ba6416f02850caf, type: 3}
    IMG: {fileID: 967051806}
    NpcDialogue: "Sem problemas. Mas para que voc\xEAs precisam de um ornitologista?"
  - NPC: 1
    FacialExpression: {fileID: 21300000, guid: 85016c28b101a6c47a04a88df87ffbd6, type: 3}
    IMG: {fileID: 621860212}
    NpcDialogue: "N\xF3s estamos aqui na Ant\xE1rtica coletando amostras de micropl\xE1stico
      na \xE1gua."
  - NPC: 1
    FacialExpression: {fileID: 21300000, guid: fcc7b7da56f7dcf47974ddc97e8f6f33, type: 3}
    IMG: {fileID: 621860212}
    NpcDialogue: "Por\xE9m,  vimos aves e outros animais presos em peda\xE7os maiores
      de res\xEDduos.\r\nComo n\xE3o temos permiss\xE3o para tocar nas aves e voc\xEA
      tem, sua participa\xE7\xE3o \xE9 essencial.\r"
  - NPC: 1
    FacialExpression: {fileID: 21300000, guid: 85016c28b101a6c47a04a88df87ffbd6, type: 3}
    IMG: {fileID: 967051806}
    NpcDialogue: "S\xF3 lembre-se de n\xE3o chegar perto dos animais, eles podem
      acabar fugindo, use a boia para resgat\xE1-los."
  - NPC: 1
    FacialExpression: {fileID: 21300000, guid: 85016c28b101a6c47a04a88df87ffbd6, type: 3}
    IMG: {fileID: 967051806}
    NpcDialogue: "Vamos come\xE7ar? S\xF3 lembrando que n\xE3o podemos ficar aqui
      fora por muito tempo, ent\xE3o precisamos ser r\xE1pidos."
  - NPC: 1
    FacialExpression: {fileID: 21300000, guid: 85016c28b101a6c47a04a88df87ffbd6, type: 3}
    IMG: {fileID: 967051806}
    NpcDialogue: "Pode dirigir o bote. Tome cuidado para n\xE3o sair da \xE1rea permitida
      e certifique-se de que coletamos todas as amostras. A rede de fitopl\xE2ncton
      para coleta dos micropl\xE1sticos est\xE1 na \xE1gua, \xE9 s\xF3 passar pelas
      \xE1reas sinalizadas."
  typingSpeed: 0.04
  textLocation: 0
  StartTyping: 0
